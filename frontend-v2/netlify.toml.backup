[build]
  publish = "dist"
  command = "npm run build"

# Mass Mailing API redirects to Mass Mailing Backend (port 8810) - Must be first to avoid conflicts
[[redirects]]
  from = "/api/mass-mailing/*"
  to = "http://34.31.224.102:8810/api/:splat"
  status = 200
  force = true
  timeout = 60
  headers = {Access-Control-Allow-Origin = "*"}

# CRM API redirects to CRM Backend (port 8809) - Must be second to avoid conflicts
[[redirects]]
  from = "/api/crm/*"
  to = "http://34.31.224.102:8809/api/:splat"
  status = 200
  force = true
  timeout = 60
  headers = {Access-Control-Allow-Origin = "*"}

# Main API redirects to Milvus Integration (port 8804) - Must be last to catch remaining API calls
[[redirects]]
  from = "/api/*"
  to = "http://34.31.224.102:8804/api/:splat"
  status = 200
  force = true
  timeout = 60
  headers = {Access-Control-Allow-Origin = "*"}

# Specific timeout for resume parsing
[[redirects]]
  from = "/api/resume-parser/parse"
  to = "http://34.31.224.102:8804/api/resume-parser/parse"
  status = 200
  force = true
  timeout = 120
  headers = {Access-Control-Allow-Origin = "*"}

[[headers]]
  for = "/*"
  [headers.values]
    Access-Control-Allow-Origin = "*"
    Access-Control-Allow-Methods = "GET, POST, PUT, DELETE, OPTIONS"
    Access-Control-Allow-Headers = "Content-Type, Authorization"
